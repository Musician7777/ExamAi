# ─── Database ───
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/examai

# ─── Authentication (NextAuth.js) ───
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Gemini AI ───
GEMINI_API_KEY=your-gemini-api-key
# Optional: second key for failover
# GEMINI_API_KEY_2=your-second-gemini-key

# ─── Hugging Face (TTS — Kokoro) ───
HF_TOKEN=your-huggingface-token

# ─── NVIDIA AI (NIM API) ───
NVIDIA_API_KEY=your-nvidia-api-key

# ─── Email (Resend) ───
# For password reset and notification emails
# Get a free API key at https://resend.com (3,000 emails/month free tier)
# If not set, the forgot-password flow will show the reset link directly (dev mode)
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM=ExamAI <onboarding@resend.dev>

# ─── Redis Cache & Rate Limiting (Upstash) ───
# Optional but recommended for production — enables persistent rate limiting and server-side caching.
# Without these, in-memory stores are used (which reset on every Vercel cold start).
# Free tier: 10K commands/day at https://upstash.com
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── CSRF Protection ───
# Secret used to sign CSRF tokens. Falls back to NEXTAUTH_SECRET if not set.
# Required in production for proper double-submit cookie CSRF protection.
# CSRF_SECRET=your-csrf-secret-here

# ─── Sentry Error Tracking ───
# Optional — enables error tracking and performance monitoring.
# Get a DSN at https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional: for source map uploads and release tracking
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_PROJECT=your-sentry-project-slug

# ─── Logging ───
# Log level for Pino logger (trace, debug, info, warn, error, fatal)
# Default: info
LOG_LEVEL=info

# ─── Google Analytics (GA4) ───
# Measurement ID from Google Analytics 4 property
# Format: G-XXXXXXXXXX — find it in GA4 → Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google AdSense ───
# Publisher ID from Google AdSense
# Format: ca-pub-XXXXXXXXXXXXXXXX — find it in AdSense → Account → Account information
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Ad Slot IDs — create ad units in AdSense → Ads → By ad unit → Get code
# Leave empty to hide ads in that position until you create the ad units
# Dashboard page bottom (horizontal auto)
NEXT_PUBLIC_AD_SLOT_DASHBOARD=
# Exam results page footer (horizontal auto)
NEXT_PUBLIC_AD_SLOT_EXAM_RESULTS=
# Sidebar bottom (vertical auto)
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
# Coding challenges page bottom (horizontal auto)
NEXT_PUBLIC_AD_SLOT_CODING=
# Analytics page bottom (horizontal auto)
NEXT_PUBLIC_AD_SLOT_ANALYTICS=
# Leaderboard page bottom (horizontal auto)
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=
